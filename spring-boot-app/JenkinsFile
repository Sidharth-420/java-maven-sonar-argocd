pipeline {

    agent {
        docker {
            image 'jib121/maven-docker-agent'
            args '--user root -v /var/run/docker.sock:/var/run/docker.sock'
        }
    }

    environment {
        DOCKER_IMAGE = "sidharth18/ultimate-cicd"
        GIT_REPO_NAME = "java-maven-sonar-argocd"
        GIT_USER_NAME = "Sidharth-420"
    }

    options {
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        skipDefaultCheckout(true)
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm

                sh '''
                    echo "Checkout successful"
                    echo "Workspace:"
                    pwd
                    ls -la
                '''
            }
        }

        stage('Build and Test') {
            steps {
                sh '''
                    cd spring-boot-app

                    echo "Building Spring Boot application..."

                    mvn clean package

                    echo "Build completed successfully."
                    ls -lh target/
                '''
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'sonarqube',
                        variable: 'SONAR_AUTH_TOKEN'
                    )
                ]) {

                    sh '''
                        cd spring-boot-app

                        mvn sonar:sonar \
                          -Dsonar.projectKey=java-maven-sonar-argocd \
                          -Dsonar.projectName="Java Maven Sonar ArgoCD" \
                          -Dsonar.host.url=http://34.201.116.83:9000 \
                          -Dsonar.token=$SONAR_AUTH_TOKEN
                    '''
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                    cd spring-boot-app

                    docker build \
                      -t ${DOCKER_IMAGE}:${BUILD_NUMBER} \
                      .
                '''
            }
        }

        stage('Push Docker Image') {
            steps {
                script {

                    def dockerImage =
                        docker.image("${DOCKER_IMAGE}:${BUILD_NUMBER}")

                    docker.withRegistry(
                        'https://index.docker.io/v1/',
                        'docker-cred'
                    ) {

                        dockerImage.push()

                        dockerImage.push('latest')
                    }
                }
            }
        }

        stage('Update Kubernetes Deployment') {
            steps {

                withCredentials([
                    string(
                        credentialsId: 'github',
                        variable: 'GITHUB_TOKEN'
                    )
                ]) {

                    sh '''
                        git config user.email "sidharthshai98@gmail.com"
                        git config user.name "${GIT_USER_NAME}"

                        echo "Updating Kubernetes deployment..."

                        sed -i "s|image: .*|image: ${DOCKER_IMAGE}:${BUILD_NUMBER}|g" \
                        spring-boot-app-manifests/deployment.yml

                        echo "Updated deployment:"
                        grep "image:" spring-boot-app-manifests/deployment.yml

                        git add spring-boot-app-manifests/deployment.yml

                        git commit \
                          -m "Update Docker image to ${BUILD_NUMBER} [skip ci]" \
                          || echo "No changes to commit"

                        git push \
                          https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git \
                          HEAD:main
                    '''
                }
            }
        }
    }

    post {

        success {
            echo 'CI/CD Pipeline completed successfully!'
        }

        failure {
            echo 'Pipeline failed. Check the Jenkins console output.'
        }

        always {
            cleanWs()
        }
    }
}
