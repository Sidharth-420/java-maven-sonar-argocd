pipeline {

    agent any

    environment {
        DOCKER_IMAGE  = "sidharth18/ultimate-cicd"
        GIT_REPO_NAME = "java-maven-sonar-argocd"
        GIT_USER_NAME = "Sidharth-420"
    }

    options {
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        skipDefaultCheckout(true)
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm

                sh '''
                    echo "===== CHECKOUT ====="
                    pwd
                    ls -la
                '''
            }
        }

        stage('Build and Test') {
            steps {
                sh '''
                    echo "===== BUILD AND TEST ====="

                    cd spring-boot-app

                    mvn clean package

                    echo "Build completed successfully."

                    ls -lh target/
                '''
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('sonarqube') {
                    sh '''
                        echo "===== SONARQUBE ANALYSIS ====="

                        cd spring-boot-app

                        mvn org.sonarsource.scanner.maven:sonar-maven-plugin:5.1.0.4751:sonar \
                          -Dsonar.projectKey=my-ec2-project \
                          -Dsonar.projectName="Spring Boot App" \
                          -Dsonar.host.url=$SONAR_HOST_URL
                    '''
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                    echo "===== DOCKER BUILD ====="

                    cd spring-boot-app

                    docker build \
                        -t ${DOCKER_IMAGE}:${BUILD_NUMBER} \
                        .

                    echo "Docker image built successfully."

                    docker images | grep "${DOCKER_IMAGE}"
                '''
            }
        }

        stage('Push Docker Image') {
            steps {
                script {

                    echo "===== DOCKER PUSH ====="

                    def dockerImage =
                        docker.image("${DOCKER_IMAGE}:${BUILD_NUMBER}")

                    docker.withRegistry(
                        'https://index.docker.io/v1/',
                        'docker-cred'
                    ) {

                        dockerImage.push()
                        dockerImage.push('latest')
                    }

                    echo "Docker image pushed successfully."
                }
            }
        }

        stage('Update Kubernetes Deployment') {
            steps {

                withCredentials([
                    string(
                        credentialsId: 'github',
                        variable: 'GITHUB_TOKEN'
                    )
                ]) {

                    sh '''
                        echo "===== UPDATE KUBERNETES DEPLOYMENT ====="

                        rm -rf gitops-repo

                        echo "Cloning GitHub repository..."

                        git clone \
                          https://${GITHUB_TOKEN}@github.com/Sidharth-420/java-maven-sonar-argocd.git \
                          gitops-repo

                        cd gitops-repo

                        echo "Repository cloned successfully."

                        git config user.email "sidharthshai98@gmail.com"
                        git config user.name "Sidharth-420"

                        echo "===== BEFORE UPDATE ====="

                        grep "image:" \
                          spring-boot-app-manifests/deployment.yml || true

                        echo "===== UPDATING IMAGE ====="

                        sed -i "s|image: .*|image: ${DOCKER_IMAGE}:${BUILD_NUMBER}|g" \
                          spring-boot-app-manifests/deployment.yml

                        echo "===== AFTER UPDATE ====="

                        grep "image:" \
                          spring-boot-app-manifests/deployment.yml

                        git status

                        git add spring-boot-app-manifests/deployment.yml

                        git commit \
                          -m "Update Docker image to ${BUILD_NUMBER} [skip ci]" \
                          || echo "No changes to commit"

                        echo "===== PUSHING TO GITHUB ====="

                        git push \
                          https://${GITHUB_TOKEN}@github.com/Sidharth-420/java-maven-sonar-argocd.git \
                          HEAD:main

                        echo "GitHub deployment file updated successfully."
                    '''
                }
            }
        }
    }

    post {
        success {
            echo '''
======================================
CI/CD PIPELINE COMPLETED SUCCESSFULLY
======================================
'''
        }

        failure {
            echo '''
======================================
CI/CD PIPELINE FAILED
Check the Jenkins console output.
======================================
'''
        }
    }
}
